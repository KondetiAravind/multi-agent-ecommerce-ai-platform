# E-commerce AI Operations Agent — Environment Variables
# Copy to backend/.env and fill in real values. Never commit real secrets.

# ============ API & SERVER ============
DEBUG=True
HOST=0.0.0.0
PORT=8000
API_TITLE=E-commerce AI Operations Agent
API_VERSION=1.0.0

# ============ DATABASE - NEON POSTGRESQL ============
# Get from https://console.neon.tech
# Format: postgresql://user:password@host/database
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ============ LLM - GROQ API ============
# Get from https://console.groq.com
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=2000

# ============ AUTH (single admin account) ============
SECRET_KEY=replace_with_a_long_random_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change_this_password

# ============ CHROMADB VECTOR STORE ============
CHROMADB_PATH=./chromadb_data
CHROMADB_COLLECTION_NAME=ecommerce_memory

# ============ EMAIL SERVICE (Optional) ============
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
EMAIL_FROM=noreply@ecommerceai.com
EMAIL_TO=admin@ecommerceai.com

# ============ SCHEDULER ============
SCHEDULER_ENABLED=True
DAILY_TRIGGER_TIME=09:00

# ============ WORKFLOW CONFIGURATION ============
CONFIDENCE_THRESHOLD=0.75
MAX_ITERATIONS=10
TIMEOUT_SECONDS=300

# ============ FRONTEND ============
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ============ LOGGING ============
LOG_LEVEL=INFO
